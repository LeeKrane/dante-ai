# Copy this file to .env and fill in real values. .env is gitignored; this
# example file is not, and must never carry a real secret.

# --- Fish Audio (required for TTS) ------------------------------------------
FISH_API_KEY=your-fish-api-key-here          # required, from fish.audio -> API Keys
FISH_VOICE_ID=e13fa398a7f445a685316a3de6089ce7  # optional, a library voice id; default: ""
FISH_MODEL=s2.1-pro-free                     # optional, default: s2.1-pro-free
FISH_FORMAT=mp3                              # optional, default: mp3
FISH_SPEED=1.1                               # optional, default: 1
FISH_PITCH=0                                 # optional, semitones, default: 0
FISH_VOLUME=5.0                              # optional, -20 to 20, default: 0

# --- Supabase (required for the sign-in gate) -------------------------------
SUPABASE_URL=https://your-project.supabase.co   # required
SUPABASE_ANON_KEY=your-anon-key-here            # required
SECURE_COOKIE=                                  # optional, "1" to mark the session cookie Secure
                                                 # (only if this server sits behind HTTPS); default: unset

# --- Server -------------------------------------------------------------
PORT=3210                                    # optional, default: 3210
DANTE_HOST=                                  # optional, default: 127.0.0.1 (loopback only).
                                              # Set to 0.0.0.0 to listen on all interfaces.
                                              # CAVEAT: hooks/dante-*.mjs always POST to
                                              # 127.0.0.1:PORT, so a specific non-loopback
                                              # DANTE_HOST breaks the hook bridge -- use
                                              # 0.0.0.0, or leave this unset, if you need hooks.
DANTE_WG_IP=                                 # optional, e.g. 192.168.82.1 (a WireGuard address);
                                              # empty/unset disables WireGuard access entirely
